__pycache__
storage
output
.ui/

# Secrets: API keys, the Supabase password, the ngrok token.
# Copy src/.env.example to src/.env and fill it in locally.
.env
!.env.example

# Local virtual environment (recreate with `uv sync`).
.venv/

# Editor / OS / tooling clutter.
.claude/
Thumbs.db
.DS_Store

# Gradio's local cache/flag directory, created at runtime.
.gradio/

# Superseded by the Supabase/pgvector store (see ARCHITECTURE.md 4.3).
# Kept ignored so an old local index left on a machine is never committed.
chroma_db

# Large raw scanned PDFs kept only as local archive material before OCR --
# the extracted, indexed text already lives in docs/. Not needed to run
# or reproduce the project, and too large to be worth versioning.
raw_sources/

# Browser profile used to log in to the Nizam regulations platform (holds session cookies).
# Never commit it.
.crawl_browser_profile/

# Raw crawl output of the IMSIU website (scripts/crawl_university.py): large and
# reproducible, so only its index and summaries are versioned. Curated files live in docs/imamu_web/.
raw_university_docs/*
!raw_university_docs/INDEX.csv
!raw_university_docs/SUMMARY.md
!raw_university_docs/FILES_LIST.md

# Over GitHub's 50 MB recommendation (62 MB); download it again from the URL in
# raw_university_docs/FILES_LIST.md when rebuilding the index.
docs/imamu_web/ccis/study_plans/الدليل_التعريفي_بكالوريوس_نظم_المعلومات.pdf

# Raw Telegram group export (students' messages). Private: never commit or serve it.
private_data/
