# ---------------------------------------------------------------------------
# Which LLM generates the answers: "hosted" (any OpenAI-compatible API) or
# "ollama" (local).
#
# hosted -> the deployment / presentation setup. Qwen3.8 27B, ~9x the size
#           of anything this laptop can hold, answers Arabic correctly with
#           per-fact citations, and replies in ~3s instead of ~40s.
# ollama -> fully offline fallback (small model, slow on CPU, weaker
#           Arabic). Kept as the measured baseline for GP2.
#
# Leaving this blank auto-picks hosted when LLM_API_KEY is set, else
# ollama, so the demo still answers (just slower) if the key is missing or
# the network is down.
# ---------------------------------------------------------------------------
LLM_PROVIDER=hosted

# --- Hosted LLM (OpenAI-API-compatible; provider-agnostic on purpose) ---
# Swapping vendor is an edit here, never a code change. Examples:
#   Groq        https://api.groq.com/openai/v1        qwen/qwen3.8-27b
#   OpenRouter  https://openrouter.ai/api/v1          qwen/qwen3-32b
#   Together    https://api.together.xyz/v1           Qwen/Qwen3-...
# List what your key can currently reach:
#   curl $LLM_API_BASE/models -H "Authorization: Bearer $LLM_API_KEY"
LLM_API_BASE=https://api.groq.com/openai/v1

# Free key from https://console.groq.com/keys -- paste it here.
# This file is git-ignored, so the key is never committed.
LLM_API_KEY=


LLM_MODEL=qwen/qwen3.8-27b

# Optional override. Unset, the code uses the model's real context window
# (131042 for qwen/qwen3.8-27b, read from Groq's model list). Lower it if
# a provider's per-minute token quota is tighter than the model's limit.
# LLM_CONTEXT_WINDOW=32768

# --- Local LLM (only used when LLM_PROVIDER=ollama) ---
MODEL=llama3.2:3b

# --- Embeddings ---
# "ollama" (local, default) or "openai" (hosted). Embeddings run at BOTH
# index-build time and per user query, so with the local option a deployed
# instance still needs a reachable Ollama -- see the tradeoff comment in
# src/settings.py:init_settings.
EMBEDDING_PROVIDER=ollama
# `ollama pull bge-m3` (multilingual; much better Arabic retrieval than
# nomic-embed-text). Changing this requires re-running `generate` AND
# updating EMBED_DIM to match the new model's vector width.
EMBEDDING_MODEL=bge-m3

# The base URL for the Ollama API (used for embeddings whenever
# EMBEDDING_PROVIDER=ollama, and for generation when LLM_PROVIDER=ollama).
OLLAMA_BASE_URL=http://127.0.0.1:11434
 
 
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Logical table name. PGVectorStore stores rows in "data_<this>", so the
# real table here is data_academic_advising.
PGVECTOR_TABLE=academic_advising

# Vector width -- must match EMBEDDING_MODEL (bge-m3 = 1024,
# text-embedding-3-small = 1536). pgvector fixes this when the column is
# created, so changing it means re-running `generate`, not a migration.
EMBED_DIM=1024

# --- App ---
# Initial questions to display in the chat (`starterQuestions`)
NEXT_PUBLIC_STARTER_QUESTIONS=["ما هي شروط الإنذار الأكاديمي؟","كيف أقدم على التحويل الداخلي بين الكليات؟","ما هي إجراءات الانسحاب من مقرر؟"]

# Public ngrok link for `fastapi_app.py --public` (Start-Public.bat). Free
# token from https://dashboard.ngrok.com/get-started/your-authtoken -- paste
# it here. Optional NGROK_DOMAIN pins a free static domain so the link stays
# the same between runs.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# How many chunks to retrieve per query. Default (unset) is small (2).
# Was 12 with nomic-embed-text, because that English-centric embedding
# ranked the right Arabic chunk ~10th and TOP_K had to be big enough to
# catch it. bge-m3 ranks it near the top, so a smaller, cleaner context
# works better (less noise for the LLM, faster prompt processing).
TOP_K=8
